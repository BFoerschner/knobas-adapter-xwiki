# --------------------------------------------------------------------------- seed

def seed():
    info = wait_for_xwiki()
    print(f"seed: XWiki {info.get('version')} at {BASE}")
    fixture = json.loads(FIXTURE.read_text())
    people = {p["id"]: p for p in fixture["people"]}

    require_login(SUPERADMIN)
    wait_for_flavor()

    # 0. Wiki settings (as superadmin, before any other login is tried).
    # No login-failure lockout: by default 3 failed logins within 300 s put an
    # account behind a captcha, which basic auth cannot answer, so every later
    # request with the right password is served as guest until the window
    # passes. Adapter tests try wrong passwords on purpose.
    ensure_props("XWiki.Authentication", "Configuration", "XWiki.Authentication.ConfigurationClass", 0,
                 {"isAuthenticationSecurityEnabled": "0"}, SUPERADMIN)
    # A private wiki, like a company one: guests may not view pages, so a
    # wrong password gets 401 on REST page resources (302 to the login page on
    # bin/ URLs) instead of a guest's 200.
    ensure_props("XWiki", "XWikiPreferences", "XWiki.XWikiPreferences", 0,
                 {"authenticate_view": "1"}, SUPERADMIN)

    # 1. The knobas admin, made by superadmin.
    ensure_user("knobas", "knobas", "Admin", "knobas@example.invalid", ADMIN[1],
                "Admin account for the knobas XWiki adapter testenv", admin=True)

    # 2. Fixture people.
    auth_of = {}
    for p in fixture["people"]:
        first, last = p["name"].split(" ", 1)
        name = user_page_name(p)
        ensure_user(name, first, last, f"{p['username']}@tidewater.example", PEOPLE_PASSWORD, p["role"])
        auth_of[p["id"]] = (name, PEOPLE_PASSWORD)
    admin_auth = ADMIN
    for auth in [ADMIN, *auth_of.values()]:
        require_login(auth)

    # 3. Tidewater space tree.
    ensure_page("Tidewater", "WebHome", "Tidewater",
                "Tidewater's team wiki.\n\n{{children/}}\n", auth_of["priya"])
    ensure_page("Tidewater.Engineering", "WebHome", "Engineering",
                "Engineering pages of the Payments team.\n\n{{children/}}\n", auth_of["priya"])
    for page in fixture["pages"]:
        space, name, body = FIXTURE_PAGES[page["id"]]
        ensure_page(space, name, page["title"], body, auth_of[page["by"]])
        for c in page["comments"]:
            text = c["text"].replace(
                "@Mara", '{{mention reference="XWiki.MaraLindqvist" style="FULL_NAME" anchor="XWiki-MaraLindqvist-sepa1"/}}')
            ensure_object(space, name, "XWiki.XWikiComments",
                          {"comment": text},
                          {"author": "XWiki." + auth_of[c["who"]][0], "date": comment_date(c["when"]),
                           "comment": text}, auth_of[c["who"]])
    ensure_tags("Tidewater.Engineering.SEPAPayoutRetryDesign", "WebHome", ["payments", "sepa", "design"],
                auth_of["mara"])
    ensure_tags("Tidewater.Engineering.OnCallHandbook", "WebHome", ["on-call", "runbook"], auth_of["tomasz"])

    # 4. Docs reader showcase.
    sc = "Tidewater.Showcase"
    ensure_page(sc, "WebHome", "Docs reader showcase", SHOWCASE_HOME, admin_auth)
    ensure_page(sc + ".IncludedSnippet", "WebHome", "Included snippet", SHOWCASE_SNIPPET, admin_auth)
    ensure_page(sc + ".Tables", "WebHome", "Tables", SHOWCASE_TABLES, admin_auth)
    ensure_page(sc + ".Macros", "WebHome", "Macros", SHOWCASE_MACROS, admin_auth)
    ensure_page(sc + ".Images", "WebHome", "Images", SHOWCASE_IMAGES, admin_auth)
    ensure_attachment(sc + ".Images", "WebHome", "knobas-logo.png", png(96, 48), "image/png", admin_auth)
    ensure_history(sc + ".Changelog", "WebHome", "Changelog (several versions)", [
        (auth_of["mara"], "== Changelog ==\n\n* v1: first draft.\n", "First draft"),
        (auth_of["jonas"], "== Changelog ==\n\n* v1: first draft.\n* v2: review notes added.\n", "Review notes"),
        (auth_of["priya"], "== Changelog ==\n\n* v1: first draft.\n* v2: review notes added.\n"
                           "* v3: approved for rollout.\n\n{{success}}Approved.{{/success}}\n", "Approved"),
    ])
    ensure_tags(sc + ".Changelog", "WebHome", ["changelog", "showcase"], auth_of["priya"])
    first = ensure_object(sc, "WebHome", "XWiki.XWikiComments",
                          {"comment": "Does the reader keep the footnote?"},
                          {"author": "XWiki.JonasBecker", "date": "20/08/2026 09:15:00",
                           "comment": "Does the reader keep the footnote?"}, auth_of["jonas"])
    ensure_object(sc, "WebHome", "XWiki.XWikiComments",
                  {"comment": "It should, as a numbered note at the end."},
                  {"author": "XWiki.MaraLindqvist", "date": "20/08/2026 10:02:00",
                   "comment": "It should, as a numbered note at the end.", "replyto": str(first)},
                  auth_of["mara"])

    # 5. A second space the adapter is not configured to sync.
    ensure_page("Outside", "WebHome", "Outside (not synced)",
                "Pages here are outside the adapter's configured space.\n\n{{children/}}\n", auth_of["lena"])
    ensure_page("Outside.ProductRoadmap", "WebHome", "Product roadmap",
                "== Q4 ==\n\n* Instant payouts pilot\n* Merchant self-service refunds\n", auth_of["lena"])

    print(f"seed: done, {len(created)} write(s)" if created else "seed: done, nothing to create")


# --------------------------------------------------------------------------- verify

def verify():
    wait_for_xwiki(seconds=30)
    failures = []

    def check(label, ok):
        print(("  ok   " if ok else "  FAIL ") + label)
        if not ok:
            failures.append(label)

    check("knobas logs in (XWiki-User header)", whoami(ADMIN) == "xwiki:XWiki.knobas")
    for name in ("MaraLindqvist", "JonasBecker", "PriyaNair", "TomaszWojcik", "LenaHoffmann"):
        user = get_json(page_url("XWiki", name) + "/objects/XWiki.XWikiUsers/0", ADMIN)
        check(f"user XWiki.{name} exists and logs in",
              user is not None and whoami((name, PEOPLE_PASSWORD)) == f"xwiki:XWiki.{name}")

    for space, name, _ in FIXTURE_PAGES.values():
        p = get_json(page_url(space, name), ADMIN)
        check(f"page {space}.{name}", p is not None and p["content"].strip() != "")

    comments = get_json(page_url("Tidewater.Engineering.SEPAPayoutRetryDesign", "WebHome")
                        + "/objects/XWiki.XWikiComments", ADMIN)
    check("SEPA page has its comment", comments is not None and len(comments["objectSummaries"]) >= 1)

    tags = get_json(page_url("Tidewater.Showcase.Changelog", "WebHome") + "/tags", ADMIN)
    check("Changelog has tags", tags is not None and {"changelog", "showcase"} <= {t["name"] for t in tags["tags"]})
    hist = get_json(page_url("Tidewater.Showcase.Changelog", "WebHome") + "/history", ADMIN)
    check("Changelog has >= 3 versions", hist is not None and len(hist["historySummaries"]) >= 3)

    att = get_json(page_url("Tidewater.Showcase.Images", "WebHome") + "/attachments", ADMIN)
    check("Images has knobas-logo.png", att is not None and any(a["name"] == "knobas-logo.png" for a in att["attachments"]))

    status, raw = request("GET", BASE + "/bin/get/Tidewater/Showcase/Macros/WebHome?xpage=plain&outputSyntax=html",
                          ADMIN, accept="text/html")
    html = raw.decode("utf-8", "replace")
    check("Macros page renders the info box", status == 200 and "infomessage" in html)
    check("Macros page renders the included snippet inline", "lives on" in html)

    check("Outside.WebHome exists", get_json(page_url("Outside", "WebHome"), ADMIN) is not None)

    status, _ = request("GET", page_url("Tidewater", "WebHome"), ("knobas", "not-the-password"))
    check("a wrong password gets 401 on a page resource", status == 401)
    check("knobas still logs in after a failed login (no lockout)", whoami(ADMIN) == "xwiki:XWiki.knobas")

    if failures:
        print(f"verify: {len(failures)} check(s) failed")
        sys.exit(1)
    print("verify: all checks passed")


if __name__ == "__main__":
    if sys.argv[1:] == ["--verify"]:
        verify()
    elif sys.argv[1:] == []:
        seed()
    else:
        sys.exit(__doc__)
