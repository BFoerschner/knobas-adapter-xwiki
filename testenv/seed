# --------------------------------------------------------------------------- HTTP

class HttpError(Exception):
    def __init__(self, status, method, url, body):
        super().__init__(f"{method} {url} -> {status}: {body[:300]!r}")
        self.status = status


def request(method, url, auth, body=None, content_type=None, accept="application/json"):
    headers = {"Accept": accept}
    token = base64.b64encode(f"{auth[0]}:{auth[1]}".encode()).decode()
    headers["Authorization"] = "Basic " + token
    data = None
    if body is not None:
        if isinstance(body, (dict, list)):
            data = json.dumps(body).encode()
            content_type = content_type or "application/json"
        elif isinstance(body, str):
            data = body.encode()
        else:
            data = body
        headers["Content-Type"] = content_type
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            raw = resp.read()
            return resp.status, raw
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def get_json(url, auth):
    status, raw = request("GET", url, auth)
    if status == 404:
        return None
    if status != 200:
        raise HttpError(status, "GET", url, raw.decode("utf-8", "replace"))
    return json.loads(raw)


def must(status, raw, method, url, ok=(200, 201, 202, 204)):
    if status not in ok:
        raise HttpError(status, method, url, raw.decode("utf-8", "replace"))


def q(s):
    return urllib.parse.quote(s, safe="")


def page_url(space_path, page):
    """space_path: 'Tidewater.Engineering' -> .../spaces/Tidewater/spaces/Engineering/pages/{page}"""
    spaces = "/".join("spaces/" + q(s) for s in space_path.split("."))
    return f"{REST}/{spaces}/pages/{q(page)}"


def whoami(auth):
    """The user XWiki served the request as, from the XWiki-User response header.

    A wrong password is not a 401: XWiki serves the request as guest and sends
    no XWiki-User header. So is an account in the login-failure lockout
    (3 failures within 300 s by default, then a captcha that basic auth cannot
    answer)."""
    req = urllib.request.Request(BASE + "/rest/", headers={
        "Authorization": "Basic " + base64.b64encode(f"{auth[0]}:{auth[1]}".encode()).decode()})
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.headers.get("XWiki-User")


def require_login(auth):
    user = whoami(auth)
    if user != f"xwiki:XWiki.{auth[0]}":
        sys.exit(f"seed: XWiki does not accept the login {auth[0]!r} (served as {user or 'guest'}). "
                 "Wrong password, or the account is in XWiki's login-failure lockout: "
                 "wait 5 minutes after the last failed login and retry.")


FLAVOR_JOB = (BASE + "/rest/jobstatus/extension/action/"
              "org.xwiki.platform%3Axwiki-platform-distribution-flavor-mainwiki/wiki%3Axwiki")


def wait_for_flavor(seconds=900):
    """On a fresh volume the Distribution Wizard installs XWiki Standard on its own
    (knobas-entrypoint.sh); the seed needs its pages and groups, so wait for it."""
    deadline = time.time() + seconds
    state = None
    while time.time() < deadline:
        status, raw = request("GET", FLAVOR_JOB, SUPERADMIN)
        if status == 200:
            state = json.loads(raw).get("state")
            if state == "FINISHED":
                return
        print(f"seed: waiting for the XWiki Standard flavor install (job {state or 'not started'})")
        time.sleep(10)
    sys.exit(f"seed: the flavor install did not finish within {seconds}s (state {state})")


def wait_for_xwiki(seconds=600):
    deadline = time.time() + seconds
    last = None
    while time.time() < deadline:
        try:
            status, raw = request("GET", BASE + "/rest/", SUPERADMIN)
            if status == 200:
                return json.loads(raw)
            last = status
        except Exception as e:  # connection refused while Tomcat starts
            last = e
        time.sleep(5)
    sys.exit(f"seed: XWiki at {BASE} did not answer within {seconds}s (last: {last})")


# --------------------------------------------------------------------------- writers

created = []

# Seed reads go through superadmin: the wiki denies view to guests, and the
# knobas admin does not exist yet on a fresh volume.
READ = SUPERADMIN


def note(what):
    created.append(what)
    print("  + " + what)


def ensure_page(space_path, page, title, content, auth, version_comment=None):
    url = page_url(space_path, page)
    existing = get_json(url, READ)
    if existing is not None:
        return existing
    body = {"title": title, "syntax": "xwiki/2.1", "content": content}
    if version_comment:
        body["comment"] = version_comment
    status, raw = request("PUT", url, auth, body)
    must(status, raw, "PUT", url, ok=(201,))
    note(f"page {space_path}.{page} by {auth[0]}")
    return json.loads(raw)


def ensure_object(space_path, page, class_name, match, properties, auth):
    """Add a `class_name` object unless one whose properties include `match` exists."""
    base = page_url(space_path, page) + "/objects/" + q(class_name)
    listing = get_json(base, READ) or {"objectSummaries": []}
    for summary in listing["objectSummaries"]:
        obj = get_json(f"{base}/{summary['number']}", READ)
        props = {p["name"]: p.get("value") for p in obj["properties"]}
        if all(props.get(k) == v for k, v in match.items()):
            return summary["number"]
    url = page_url(space_path, page) + "/objects"
    body = {
        "className": class_name,
        "properties": [{"name": k, "value": v} for k, v in properties.items()],
    }
    status, raw = request("POST", url, auth, body)
    must(status, raw, "POST", url, ok=(201,))
    number = json.loads(raw)["number"]
    note(f"object {class_name}[{number}] on {space_path}.{page}")
    return number


def ensure_user(user_page, first, last, email, password, about, admin=False):
    url = page_url("XWiki", user_page)
    if get_json(url, SUPERADMIN) is None:
        status, raw = request("PUT", url, SUPERADMIN, {"title": f"{first} {last}", "content": ""})
        must(status, raw, "PUT", url, ok=(201,))
        note(f"user page XWiki.{user_page}")
    ensure_object("XWiki", user_page, "XWiki.XWikiUsers", {},
                  {"first_name": first, "last_name": last, "email": email,
                   "password": password, "active": "1", "company": "Tidewater",
                   "comment": about}, SUPERADMIN)
    ensure_object("XWiki", "XWikiAllGroup", "XWiki.XWikiGroups",
                  {"member": f"XWiki.{user_page}"}, {"member": f"XWiki.{user_page}"}, SUPERADMIN)
    if admin:
        ensure_object("XWiki", "XWikiAdminGroup", "XWiki.XWikiGroups",
                      {"member": f"XWiki.{user_page}"}, {"member": f"XWiki.{user_page}"}, SUPERADMIN)


def ensure_props(space_path, page, class_name, number, props, auth):
    """Set properties on object `class_name`[number], creating the object if missing."""
    url = page_url(space_path, page) + f"/objects/{q(class_name)}/{number}"
    obj = get_json(url, auth)
    if obj is None:
        ensure_object(space_path, page, class_name, props, props, auth)
        return
    current = {p["name"]: p.get("value") for p in obj["properties"]}
    if all(current.get(k) == v for k, v in props.items()):
        return
    status, raw = request("PUT", url, auth, {"properties": [{"name": k, "value": v} for k, v in props.items()]})
    must(status, raw, "PUT", url, ok=(200, 202))
    note(f"{class_name}[{number}] on {space_path}.{page}: {props}")


def ensure_tags(space_path, page, tags, auth):
    url = page_url(space_path, page) + "/tags"
    current = get_json(url, READ) or {"tags": []}
    names = sorted(t["name"] for t in current.get("tags", []))
    if names == sorted(tags):
        return
    body = {"tags": [{"name": t} for t in tags]}
    status, raw = request("PUT", url, auth, body)
    must(status, raw, "PUT", url, ok=(200, 201, 202))
    note(f"tags {tags} on {space_path}.{page}")


def ensure_attachment(space_path, page, name, data, mime, auth):
    url = page_url(space_path, page) + "/attachments"
    listing = get_json(url, READ) or {"attachments": []}
    if any(a["name"] == name for a in listing["attachments"]):
        return
    status, raw = request("PUT", f"{url}/{q(name)}", auth, data, content_type=mime)
    must(status, raw, "PUT", f"{url}/{q(name)}", ok=(201, 202))
    note(f"attachment {name} on {space_path}.{page}")


def ensure_history(space_path, page, title, edits):
    """edits: [(auth, content, version comment)]; applies the ones after the current content."""
    url = page_url(space_path, page)
    existing = get_json(url, READ)
    start = 0
    if existing is not None:
        contents = [c for _, c, _ in edits]
        if existing["content"] in contents:
            start = contents.index(existing["content"]) + 1
        else:
            return  # edited by hand since; leave it
    for auth, content, comment in edits[start:]:
        body = {"title": title, "syntax": "xwiki/2.1", "content": content, "comment": comment}
        status, raw = request("PUT", url, auth, body)
        must(status, raw, "PUT", url, ok=(201, 202))
        note(f"edit of {space_path}.{page} by {auth[0]} ({comment})")


def png(width, height):
    """A small teal/amber gradient PNG, built with the standard library."""
    rows = b""
    for y in range(height):
        row = b"\x00"
        for x in range(width):
            t = x / max(1, width - 1)
            r = int(20 + 220 * t)
            g = int(140 - 20 * t + 60 * (y / max(1, height - 1)))
            b = int(150 - 120 * t)
            row += bytes((r, g, b))
        rows += row

    def chunk(kind, payload):
        c = struct.pack(">I", len(payload)) + kind + payload
        return c + struct.pack(">I", zlib.crc32(kind + payload) & 0xFFFFFFFF)

    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(rows, 9))
            + chunk(b"IEND", b""))


