def user_page_name(person):
    return "".join(part[:1].upper() + part[1:] for part in person["name"].replace("ó", "o").split())


def comment_date(iso):
    # XWikiComments.date uses the class's dateFormat dd/MM/yyyy HH:mm:ss, read in the
    # server's time zone (UTC in the container).
    return f"{iso[8:10]}/{iso[5:7]}/{iso[0:4]} {iso[11:19]}"


